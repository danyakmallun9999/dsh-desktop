{
  "name": "dsh-desktop",
  "version": "1.0.0",
  "description": "DeepSeek Harness Desktop App (Community Edition)",
  "main": "main.js",
  "bin": {
    "dsh-desktop": "./bin/cli.js"
  },
  "scripts": {
    "start": "electron . --no-sandbox",
    "dev": "electron . --no-sandbox",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "electron",
    "desktop",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.community.deepseek.harness",
    "productName": "DeepSeek Harness",
    "files": [
      "main.js",
      "preload.js",
      "loading.html",
      "deepseek.png",
      "splash_artwork.jpg",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "deepseek.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "deepseek.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeepSeek Harness"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "deepseek.png"
    }
  },
  "dependencies": {
    "electron": "^34.0.0"
  },
  "devDependencies": {
    "electron-builder": "^25.1.8"
  }
}
